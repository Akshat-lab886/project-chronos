# ── LLM Provider ──
LLM_PROVIDER=ollama          # ollama | gemini | openai | deepseek
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPEEK_API_KEY=

# ── Stock API Keys ──
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── TTS Settings ──
TTS_MODEL=kokoro             # kokoro | edge-tts | pyttsx3 | silent
TTS_VOICE=default            # Voice identifier for selected TTS engine
WHISPER_MODEL_SIZE=large-v3  # large-v3 | medium | small | turbo
WHISPER_DEVICE=cpu           # cpu | cuda | mps

# ── ComfyUI Settings ──
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=false        # Set to true to enable AI fallback generation

# ── Audio Mastering ──
TARGET_LUFS=-14.0
TRUE_PEAK=-1.0
LRA_TARGET=7.0

# ── FFmpeg ──
FFMPEG_THREADS=4

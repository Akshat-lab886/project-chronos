{
  "name": "project-chronos-remotion",
  "version": "1.0.0",
  "description": "Remotion motion graphics engine for Project Chronos — autonomous documentary video rendering.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio --disable-gpu",
    "render": "remotion render",
    "build": "remotion render DocumentaryMaster ./workspace/output/master.mp4 --frames=0:100 --quality=high",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.524"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@remotion/cli": "^4.0.524",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
